{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alkaline.invalid/schemas/alkaline-plugin.schema.json",
  "title": "Alkaline plugin manifest (schema 1)",
  "description": "alkaline-plugin.json at the root of a legacy (Minecraft 1.8.9) Alkaline plugin jar. See manifest.md.",
  "type": "object",
  "required": ["schema", "id", "name", "version", "entrypoint", "api", "minecraft"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 48 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "entrypoint": { "type": "string", "pattern": "^[\\p{L}_$][\\p{L}\\p{N}_$]*(\\.[\\p{L}_$][\\p{L}\\p{N}_$]*)+$" },
    "api": { "type": "integer", "minimum": 1 },
    "minecraft": { "const": "1.8.9" },
    "description": { "type": "string", "maxLength": 280 },
    "authors": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1, "maxLength": 64 },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 64 },
              "contact": { "type": "string", "maxLength": 256 }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "license": { "type": "string", "maxLength": 64 },
    "links": {
      "type": "object",
      "properties": {
        "homepage": { "$ref": "#/$defs/link" },
        "source": { "$ref": "#/$defs/link" },
        "issues": { "$ref": "#/$defs/link" }
      },
      "additionalProperties": false
    },
    "icon": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).*\\.png$", "maxLength": 256 },
    "dependencies": { "$ref": "#/$defs/dependencies" },
    "optionalDependencies": { "$ref": "#/$defs/dependencies" },
    "channels": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(?!MC\\|)[\\x21-\\x7E]{1,20}$" },
      "uniqueItems": true
    },
    "settings": { "type": "array", "items": { "$ref": "#/$defs/setting" } },
    "hud": { "type": "array", "items": { "$ref": "#/$defs/hud" } }
  },
  "patternProperties": { "^x-": true },
  "additionalProperties": false,
  "$defs": {
    "link": { "type": "string", "pattern": "^(https?://|mailto:)", "maxLength": 512 },
    "dependencies": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 256, "description": "An npm-style version range, such as ^1.2.0 or >=1.0.0 <2.0.0." }
    },
    "settingBase": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 48 },
        "description": { "type": "string", "maxLength": 200 }
      }
    },
    "setting": {
      "allOf": [{ "$ref": "#/$defs/settingBase" }],
      "oneOf": [
        {
          "properties": {
            "id": true, "title": true, "description": true,
            "type": { "const": "boolean" },
            "default": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "required": ["min", "max"],
          "properties": {
            "id": true, "title": true, "description": true,
            "type": { "const": "integer" },
            "min": { "type": "integer" }, "max": { "type": "integer" }, "default": { "type": "integer" }
          },
          "additionalProperties": false
        },
        {
          "required": ["min", "max"],
          "properties": {
            "id": true, "title": true, "description": true,
            "type": { "const": "decimal" },
            "min": { "type": "number" }, "max": { "type": "number" }, "default": { "type": "number" }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "id": true, "title": true, "description": true,
            "type": { "const": "color" },
            "default": { "type": "string", "pattern": "^#[0-9a-fA-F]{8}$" }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "id": true, "title": true, "description": true,
            "type": { "const": "text" },
            "maxLength": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "default": { "type": "string", "pattern": "^[^\\n]*$" }
          },
          "additionalProperties": false
        },
        {
          "required": ["options"],
          "properties": {
            "id": true, "title": true, "description": true,
            "type": { "const": "choice" },
            "options": {
              "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 32 }
            },
            "default": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "id": true, "title": true, "description": true,
            "type": { "const": "key" },
            "default": { "type": "string", "pattern": "^(none|key:[^\\p{Cntrl}]{1,32}|mouse:(left|right|middle|x1|x2))$" }
          },
          "additionalProperties": false
        }
      ]
    },
    "hud": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 48 },
        "description": { "type": "string", "maxLength": 200 },
        "anchor": {
          "enum": ["top_left", "top", "top_right", "left", "center", "right", "bottom_left", "bottom", "bottom_right"]
        },
        "x": { "type": "number", "minimum": -4096, "maximum": 4096 },
        "y": { "type": "number", "minimum": -4096, "maximum": 4096 },
        "scale": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
